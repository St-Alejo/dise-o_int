# nginx de origen único: sirve la SPA y hace de proxy a la API (REST + WebSocket).
# CSP: 'wasm-unsafe-eval' permite compilar WebAssembly (decodificadores de <model-viewer>) sin permitir eval() de JS.
# Mismo origen = sin CORS, cookies SameSite=strict funcionan, un solo dominio que certificar.
# ${API_UPSTREAM} se sustituye al arrancar (plantillas de la imagen oficial de nginx).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Resolución DNS dinámica del upstream: si la API se recrea o escala y cambia de IP,
# nginx la vuelve a resolver (con `upstream` estático quedaría apuntando a la IP vieja → 502).
# NGINX_LOCAL_RESOLVERS lo rellena la imagen oficial a partir de /etc/resolv.conf.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    set $api_upstream http://${API_UPSTREAM};

    client_max_body_size 16m;
    client_body_timeout 60s;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml model/gltf-binary;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(self), xr-spatial-tracking=(self), geolocation=(), microphone=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss: blob: data:; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # WebSocket de progreso en vivo
    location ^~ /api/ws/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }

    # ^~ : tiene prioridad sobre la regla regex de estáticos (p. ej. /api/catalog/x/model.glb)
    location ^~ /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 120s;
        proxy_buffering on;
        # La API ya envía sus cabeceras de seguridad (helmet); se evita duplicarlas.
        proxy_hide_header X-Content-Type-Options;
    }

    # Bundles con hash en el nombre: caché de un año
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|webp|svg|ico|glb)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # SPA: cualquier otra ruta devuelve index.html (sin caché, para ver despliegues nuevos)
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss: blob: data:; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    }
}
