{
  "name": "api",
  "version": "0.1.0",
  "description": "API gateway (NestJS, arquitectura hexagonal) + worker de jobs BullMQ",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "seed": "node dist/cli/seed.js",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/ test/",
    "test": "npm run prisma:generate && vitest run",
    "test:watch": "vitest",
    "test:cov": "npm run prisma:generate && vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@interiores/furniture-kit": "*",
    "@interiores/shared-types": "*",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/platform-socket.io": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.10",
    "cookie-parser": "^1.4.7",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "oxlint": "^1.86.0",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "typescript": "~6.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
