// Esquema relacional de la API. Los value objects del dominio (RoomShell, placements)
// se guardan como JSONB validado con zod; las entidades con ciclo de vida propio
// (versiones, previews, links, auditoría de jobs) tienen su propia tabla.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  uploaded
  processing
  ready
  failed
}

enum PreviewStatus {
  pending
  ready
  failed
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  displayName   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 del token: el valor en claro nunca se guarda.
  tokenHash  String    @unique
  /// Familia de rotación: si se reutiliza un token revocado se revoca toda la familia.
  family     String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Project {
  id              String         @id @default(uuid()) @db.Uuid
  ownerId         String         @db.Uuid
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  roomType        String
  status          ProjectStatus  @default(uploaded)
  lastError       String?
  photoKey        String?
  photoHash       String?
  thumbKey        String?
  roomShell       Json?
  placements      Json           @default("[]")
  /// Acabados del cuarto (piso, paredes, techo); null = por defecto.
  finishes        Json?
  /// Medidas reales que dio el usuario al crear el proyecto: mandan sobre la estimación de la IA.
  requestedRoom   Json?
  /// Muebles que el análisis reconoció en la foto; null = sin foto o análisis que no los nombra.
  photoInventory  Json?
  /// Vivienda: los cuartos de una misma persona con el mismo homeId se enseñan juntos.
  homeId          String?        @db.Uuid
  homeName        String?
  /// Dónde se dibuja el cuarto en la planta conjunta de su vivienda ({x, z} en metros).
  homePosition    Json?
  /// Tope de gasto que se puso la persona para este cuarto; null = sin tope.
  budgetCap       Float?
  /// Brief de diseño: lo que la persona pidió y quiere conservar entre recomendaciones.
  brief           Json?
  selectedStyleId String?
  /// Estilos pedidos al subir la foto (el worker los genera en el pipeline inicial).
  requestedStyles String[]       @default([])
  saved           Boolean        @default(false)
  revision        Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  versions        ProjectVersion[]
  previews        StylePreview[]
  shareLinks      ShareLink[]
  jobs            JobAudit[]
  recommendations RecommendationFeedback[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, homeId])
  @@index([saved, createdAt])
  @@map("projects")
}

model ProjectVersion {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number          Int
  note            String?
  roomShell       Json?
  placements      Json
  finishes        Json?
  selectedStyleId String?
  createdAt       DateTime @default(now())

  @@unique([projectId, number])
  @@map("project_versions")
}

model StylePreview {
  id             String        @id @default(uuid()) @db.Uuid
  projectId      String        @db.Uuid
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  styleId        String
  promptStrength Float
  status         PreviewStatus @default(pending)
  imageKey       String?
  /// sha256(foto + estilo + intensidad + proveedor): regenerar lo mismo no vuelve a costar.
  cacheKey       String
  provider       String?
  error          String?
  createdAt      DateTime      @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, cacheKey])
  @@map("style_previews")
}

model CatalogItem {
  id           String   @id
  name         String
  category     String
  subcategory  String?
  styleTags    String[]
  roomTypes    String[]
  widthM       Float
  heightM      Float
  depthM       Float
  mount        String   @default("floor")
  modelKey     String
  thumbnailKey String?
  price        Float?
  currency     String   @default("USD")
  productUrl   String?
  license      String
  attribution  String?
  source       String
  /// Palabras clave y sinónimos (es/en) para la búsqueda.
  tags         String[] @default([])
  synonyms     String[] @default([])
  description  String?
  /// Personalización: receta paramétrica, slots de material, rangos de tamaño, montaje en pared...
  spec         Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@map("catalog_items")
}

model ShareLink {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token     String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([projectId])
  @@map("share_links")
}

model JobAudit {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobId      String
  kind       String
  status     String
  attempts   Int       @default(0)
  error      String?
  requestId  String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@index([projectId, startedAt])
  @@map("job_audit")
}

/// Historial de "Recomendar": cada propuesta enseñada y lo que la persona hizo con ella. Con los
/// rasgos (features) se aprende qué le gusta.
model RecommendationFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId   String   @db.Uuid
  /// La propuesta a la que responde este gesto (null = la propuesta misma, acción 'shown').
  parentId  String?  @db.Uuid
  styleId   String
  features  Json
  /// shown | like | dislike | kept | undone
  action    String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([ownerId, createdAt])
  @@map("recommendation_feedback")
}
