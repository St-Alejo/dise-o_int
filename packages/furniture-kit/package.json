{
  "name": "@interiores/furniture-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Muebles paramétricos: recetas que generan geometría pura (sin three.js) a medidas reales, por slot de material.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@interiores/shared-types": "*"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
