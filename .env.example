# ============================================================================
# Interiores IA — variables de entorno. Copia este archivo a `.env`:
#   cp .env.example .env
# En la nube, define las mismas variables en el panel del proveedor.
# NUNCA subas .env a git.
# ============================================================================

# ---- Docker Compose: bake evita un fallo de build en rutas con caracteres no ASCII (p. ej. "diseño")
COMPOSE_BAKE=true

# ---- General
NODE_ENV=production
LOG_LEVEL=info
WEB_PORT=8080
PUBLIC_WEB_URL=http://localhost:8080
# En producción con HTTPS pon COOKIE_SECURE=true
COOKIE_SECURE=false

# ---- PostgreSQL (en la nube: usa el DATABASE_URL del Postgres gestionado)
POSTGRES_USER=interiores
POSTGRES_PASSWORD=interiores-dev-password
POSTGRES_DB=interiores

# ---- Almacenamiento S3 (local: SeaweedFS. Nube: AWS S3 / Cloudflare R2 / cualquier S3)
S3_BUCKET=interiores
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=interiores
S3_SECRET_ACCESS_KEY=interiores-dev-s3-secret
# Déjalo vacío para AWS S3; para R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=http://storage:8333
S3_FORCE_PATH_STYLE=true

# ---- Secretos (genera valores aleatorios: `openssl rand -base64 48`)
JWT_ACCESS_SECRET=dev-only-jwt-secret-please-replace-0123456789abcdef
MEDIA_SIGNING_SECRET=dev-only-media-secret-please-replace-0123456789abcdef
AI_INTERNAL_TOKEN=dev-only-ai-internal-token-0123456789

# ---- Límites y privacidad
UPLOAD_MAX_MB=15
GENERATIONS_PER_DAY=40

# Chat de diseño: con API key responde Claude (tool use); sin ella, el asistente por reglas (gratis).
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
CHAT_PER_DAY=60
RETENTION_HOURS=24
THROTTLE_LIMIT_PER_MIN=240
# Multiplica los límites por IP (registro, login, crear proyectos, chat). En producción, 1.
# Las pruebas e2e lanzan toda la suite desde una sola IP en menos de un minuto: para correrlas, 20.
RATE_LIMIT_MULTIPLIER=1
WORKER_CONCURRENCY=2

# ---- IA: proveedores (Strategy). mock = sin GPU ni costo. replicate = inferencia hospedada.
# ROOM_ANALYZER=vision: un modelo multimodal lee la foto (forma, puertas, ventanas, muebles y
# colores). Necesita GROQ_API_KEY (console.groq.com tiene capa gratuita); sin clave, o si el
# modelo alcanza su límite, responde el análisis local. Las pruebas E2E esperan mock.
ROOM_ANALYZER=mock
GROQ_API_KEY=
VISION_MODEL=qwen/qwen3.8-27b
# Tope de fotos por día que se mandan al modelo de visión (cuida la capa gratuita).
VISION_PER_DAY=20
STYLE_GENERATOR=mock
REPLICATE_API_TOKEN=
REPLICATE_DEPTH_MODEL=chenxwh/depth-anything-v2
REPLICATE_STYLE_MODEL=adirik/interior-design

# ---- Catálogo: true = no descargar modelos de Poly Haven (solo procedurales)
CATALOG_OFFLINE=false

# ---- Imágenes publicadas (docker-compose.prod.yml)
IMAGE_REGISTRY=ghcr.io/tu-usuario
IMAGE_TAG=latest
